[Unit]
Description=Smart Security System - Board main process (HTTPS server + REST API)

After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/smart-security/bin/security-board 402102668 "Sina Hashemi" http://192.168.1.105:8090/stream.mjpg http://127.0.0.1:8091/annotated.mjpg
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
User=security
Group=security
WorkingDirectory=/opt/smart-security
StandardOutput=journal
StandardError=journal
SyslogIdentifier=security-board

[Install]
WantedBy=multi-user.target
